# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Pooled connection for Prisma (via PgBouncer)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/chatdb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection for migrations
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/chatdb?sslmode=require"

# ─── Upstash Redis ────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxx..."

# ─── Pusher Channels ──────────────────────────────────────────────────────────
PUSHER_APP_ID="1234567"
PUSHER_SECRET="your_pusher_secret"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_xxx"
CLERK_SECRET_KEY="sk_live_xxx"
CLERK_WEBHOOK_SECRET="whsec_xxx"  # From Clerk Dashboard > Webhooks

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID="your_cf_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_BUCKET_NAME="chat-media"
R2_CDN_URL="https://cdn.yourdomain.com"  # Your R2 public domain or Worker URL

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
